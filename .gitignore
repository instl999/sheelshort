# Python
.venv/
__pycache__/
*.pyc

# Local configuration: holds the real ComfyUI server addresses (copy config.example.toml)
spike/config.toml
spike/config_cams.toml

# Generated outputs and local inputs (test photos and Blender sets are regenerated by the scripts)
spike/out/
spike/out_*/
spike/inputs/

# Claude Code: the MiniMax h3-prompt-writing skill has no license; tools/install_h3_skill.py fetches it
.claude/

# sheelshort engine: local server config, caches, and generated project media (only bible + episodes are committed)
sheelshort.toml
.cache/
projects/*/*
!projects/*/bible.json
!projects/*/episodes/

# local notes for the owner
PENDING_APPROVALS.md

# lan example project (蓝城雲境): every asset it made is kept in git: films, location pack, plates, the location renders in
# cache/ and, once written, its cast and episodes (state.json, logs and requests/ name the servers: they stay local)
!projects/lan/films/
!projects/lan/locations/
!projects/lan/inputs/
!projects/lan/make_locations.py
!projects/lan/README.md
!projects/lan/cache/
!projects/lan/assets/
!projects/lan/voices/
